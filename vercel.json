{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "dev": true,
      "staging": true
    }
  },
  "crons": [
    {
      "path": "/api/jobs/expiry-reminders",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/jobs/draft-sweep",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/jobs/photo-purge",
      "schedule": "0 17 * * *"
    }
  ]
}
