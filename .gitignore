# Local AI runtime state
.atl/
.codegraph/
# Legacy nested-agent/runtime residue stays ignored. New task worktrees are
# siblings outside this checkout (AGENTS.md §6), not nested here. Preserve
# this protection: nested biome.json files can still break repo-wide lint.
.claude/

# Secrets — never commit these. The repository is private, which means
# GitHub secret scanning is off: nothing catches a leaked key but this file.
.env
.env.*
!.env.example

# Design tool exports — the extracted contents are versioned under design/reference/sistema/
*.zip

# Dependencies
/node_modules

# Next.js build output
/.next/
/out/

# TypeScript build info
*.tsbuildinfo

# Note: next-env.d.ts is deliberately NOT ignored here, unlike the Next.js
# default template. `pnpm tsc --noEmit` is a CI gate with no dependency on
# `next dev`/`next build` running first (design.md, Continuous Integration
# table), so the file that satisfies its tsconfig.json `include` entry must
# exist on a fresh clone.

# Test and coverage artifacts
/coverage
/playwright-report
/test-results

# Lighthouse CI's local report output (lighthouserc.json upload.outputDir)
/.lighthouseci

# Compose has no persistent volume; preserve manual rentas-pg data/services.
# Destructive test DBs must be separately owned; cleanup follows AGENTS.md §6.

# Local MCP server wiring: it points at this machine, not at the product
/.mcp.json
